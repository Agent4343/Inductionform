          "required": true
        },
        {
          "id": "end-time",
          "type": "time",
          "label": "End Time",
          "required": true
        },
        {
          "id": "location",
          "type": "text",
          "label": "Work Location",
          "required": true
        },
        {
          "id": "work-type",
