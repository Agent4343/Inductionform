{
  "templates": [
    {
      "id": "safety-inspection-001",
      "name": "Daily Safety Inspection",
      "category": "Safety",
      "description": "Quick daily safety walkthrough for industrial sites",
      "estimatedTime": "5-10 min",
      "version": "1.0",
      "fields": [
        {
          "id": "header",
          "type": "section",
          "label": "Inspection Details"
        },
        {
          "id": "date",
          "type": "date",
          "label": "Inspection Date",
          "required": true
        },
        {
          "id": "location",
          "type": "dropdown",
          "label": "Work Area / Location",
          "required": true,
          "options": ["Warehouse A", "Warehouse B", "Loading Dock", "Manufacturing Floor", "Office Area", "Parking Lot", "Other"]
        },
        {
          "id": "shift",
          "type": "dropdown",
          "label": "Shift",
          "required": true,
          "options": ["Day Shift", "Afternoon Shift", "Night Shift"]
        },
        {
          "id": "inspector",
          "type": "text",
          "label": "Inspector Name",
          "required": true
        },
        {
          "id": "ppe-section",
          "type": "section",
          "label": "Personal Protective Equipment (PPE)"
        },
        {
          "id": "ppe-available",
          "type": "yesNo",
          "label": "Required PPE available and in good condition?",
          "required": true
        },
        {
          "id": "ppe-worn",
          "type": "yesNo",
          "label": "All personnel wearing required PPE?",
          "required": true
        },
        {
          "id": "housekeeping-section",
          "type": "section",
          "label": "Housekeeping"
        },
        {
          "id": "floors-clear",
          "type": "yesNo",
          "label": "Floors clear of debris and spills?",
          "required": true
        },
        {
          "id": "aisles-clear",
          "type": "yesNo",
          "label": "Aisles and walkways clear?",
          "required": true
        },
        {
          "id": "waste-disposed",
          "type": "yesNo",
          "label": "Waste properly disposed?",
          "required": true
        },
        {
          "id": "equipment-section",
          "type": "section",
          "label": "Equipment & Machinery"
        },
        {
          "id": "guards-in-place",
          "type": "yesNo",
          "label": "All machine guards in place?",
          "required": true
        },
        {
          "id": "equipment-condition",
          "type": "yesNo",
          "label": "Equipment in safe operating condition?",
          "required": true
        },
        {
          "id": "lockout-tagout",
          "type": "yesNo",
          "label": "Lockout/Tagout procedures followed?",
          "required": true
        },
        {
          "id": "emergency-section",
          "type": "section",
          "label": "Emergency Preparedness"
        },
        {
          "id": "exits-clear",
          "type": "yesNo",
          "label": "Emergency exits clear and accessible?",
          "required": true
        },
        {
          "id": "extinguishers-ok",
          "type": "yesNo",
          "label": "Fire extinguishers accessible and charged?",
          "required": true
        },
        {
          "id": "first-aid-stocked",
          "type": "yesNo",
          "label": "First aid kit stocked and accessible?",
          "required": true
        },
        {
          "id": "issues-section",
          "type": "section",
          "label": "Issues & Actions"
        },
        {
          "id": "hazards-found",
          "type": "yesNo",
          "label": "Any hazards identified?",
          "required": true
        },
        {
          "id": "hazard-description",
          "type": "textarea",
          "label": "Describe hazards found (if any)",
          "required": false,
          "placeholder": "Describe any safety concerns..."
        },
        {
          "id": "hazard-photo",
          "type": "photo",
          "label": "Photo of hazard (if applicable)",
          "required": false
        },
        {
          "id": "corrective-action",
          "type": "textarea",
          "label": "Corrective actions taken or required",
          "required": false
        },
        {
          "id": "overall-rating",
          "type": "dropdown",
          "label": "Overall Safety Rating",
          "required": true,
          "options": ["Satisfactory", "Needs Improvement", "Unsatisfactory - Immediate Action Required"]
        },
        {
          "id": "comments",
          "type": "textarea",
          "label": "Additional Comments",
          "required": false
        },
        {
          "id": "signature-section",
          "type": "section",
          "label": "Verification"
        },
        {
          "id": "inspector-signature",
          "type": "signature",
          "label": "Inspector Signature",
          "required": true
        },
        {
          "id": "gps-location",
          "type": "location",
          "label": "GPS Location",
          "required": false
        }
      ]
    },
    {
      "id": "incident-report-001",
      "name": "Incident / Accident Report",
      "category": "Safety",
      "description": "Document workplace incidents and near-misses",
      "estimatedTime": "10-15 min",
      "version": "1.0",
      "fields": [
        {
          "id": "header",
          "type": "section",
          "label": "Incident Information"
        },
        {
          "id": "incident-date",
          "type": "date",
          "label": "Date of Incident",
          "required": true
        },
        {
          "id": "incident-time",
          "type": "time",
          "label": "Time of Incident",
          "required": true
        },
        {
          "id": "incident-type",
          "type": "dropdown",
          "label": "Type of Incident",
          "required": true,
          "options": ["Injury - First Aid", "Injury - Medical Treatment", "Injury - Lost Time", "Near Miss", "Property Damage", "Environmental", "Vehicle Incident", "Other"]
        },
        {
          "id": "location",
          "type": "text",
          "label": "Location of Incident",
          "required": true
        },
        {
          "id": "injured-section",
          "type": "section",
          "label": "Injured Person Details"
        },
        {
          "id": "injured-name",
          "type": "text",
          "label": "Name of Injured Person",
          "required": false
        },
        {
          "id": "injured-job",
          "type": "text",
          "label": "Job Title / Role",
          "required": false
        },
        {
          "id": "injury-type",
          "type": "multiSelect",
          "label": "Type of Injury",
          "required": false,
          "options": ["Cut/Laceration", "Bruise/Contusion", "Sprain/Strain", "Fracture", "Burn", "Eye Injury", "Respiratory", "Other"]
        },
        {
          "id": "body-part",
          "type": "multiSelect",
          "label": "Body Part Affected",
          "required": false,
          "options": ["Head", "Eyes", "Face", "Neck", "Back", "Chest", "Arm", "Hand", "Leg", "Foot", "Multiple"]
        },
        {
          "id": "description-section",
          "type": "section",
          "label": "Incident Description"
        },
        {
          "id": "description",
          "type": "textarea",
          "label": "Describe what happened",
          "required": true,
          "placeholder": "Provide a detailed description of the incident..."
        },
        {
          "id": "immediate-cause",
          "type": "textarea",
          "label": "Immediate cause of incident",
          "required": true
        },
        {
          "id": "witnesses",
          "type": "textarea",
          "label": "Witness names and contact info",
          "required": false
        },
        {
          "id": "photo1",
          "type": "photo",
          "label": "Photo 1 - Scene",
          "required": false
        },
        {
          "id": "photo2",
          "type": "photo",
          "label": "Photo 2 - Additional",
          "required": false
        },
        {
          "id": "treatment-section",
          "type": "section",
          "label": "Treatment & Response"
        },
        {
          "id": "first-aid-given",
          "type": "yesNo",
          "label": "First aid administered on site?",
          "required": true
        },
        {
          "id": "first-aid-details",
          "type": "textarea",
          "label": "First aid details",
          "required": false
        },
        {
          "id": "medical-attention",
          "type": "yesNo",
          "label": "Medical attention required?",
          "required": true
        },
        {
          "id": "hospital-name",
          "type": "text",
          "label": "Hospital/Clinic name (if applicable)",
          "required": false
        },
        {
          "id": "corrective-section",
          "type": "section",
          "label": "Corrective Actions"
        },
        {
          "id": "immediate-actions",
          "type": "textarea",
          "label": "Immediate corrective actions taken",
          "required": true
        },
        {
          "id": "preventive-actions",
          "type": "textarea",
          "label": "Recommended preventive measures",
          "required": true
        },
        {
          "id": "signature-section",
          "type": "section",
          "label": "Signatures"
        },
        {
          "id": "reporter-name",
          "type": "text",
          "label": "Reporter Name",
          "required": true
        },
        {
          "id": "reporter-signature",
          "type": "signature",
          "label": "Reporter Signature",
          "required": true
        },
        {
          "id": "supervisor-name",
          "type": "text",
          "label": "Supervisor Name",
          "required": true
        },
        {
          "id": "supervisor-signature",
          "type": "signature",
          "label": "Supervisor Signature",
          "required": true
        },
        {
          "id": "gps-location",
          "type": "location",
          "label": "GPS Location",
          "required": false
        }
      ]
    },
    {
      "id": "equipment-checklist-001",
