        {
          "id": "worker-name",
          "type": "text",
          "label": "Worker Performing Hot Work",
          "required": true
        },
        {
          "id": "fire-watch-name",
          "type": "text",
          "label": "Fire Watch Person",
          "required": true
        },
        {
          "id": "precautions-section",
          "type": "section",
          "label": "Fire Prevention Precautions"
        },
        {
          "id": "combustibles-removed",
          "type": "yesNo",
          "label": "Combustibles removed or protected (35ft radius)?",
          "required": true
        },
        {
          "id": "floors-swept",
          "type": "yesNo",
          "label": "Floors swept clean?",
          "required": true
        },
        {
          "id": "openings-covered",
          "type": "yesNo",
          "label": "Floor/wall openings covered?",
          "required": true
        },
        {
          "id": "fire-extinguisher-present",
          "type": "yesNo",
          "label": "Fire extinguisher within 20ft?",
          "required": true
        },
        {
          "id": "sprinklers-operational",
          "type": "yesNo",
          "label": "Sprinkler system operational?",
          "required": true
        },
        {
          "id": "ventilation",
          "type": "yesNo",
          "label": "Adequate ventilation provided?",
          "required": true
        },
        {
          "id": "gas-testing",
          "type": "yesNo",
          "label": "Atmosphere tested (if confined space)?",
          "required": false
        },
        {
          "id": "authorization-section",
          "type": "section",
          "label": "Authorization"
        },
        {
          "id": "worker-signature",
          "type": "signature",
          "label": "Worker Signature",
          "required": true
        },
        {
          "id": "fire-watch-signature",
          "type": "signature",
          "label": "Fire Watch Signature",
          "required": true
        },
        {
          "id": "supervisor-signature",
          "type": "signature",
          "label": "Supervisor Authorization",
          "required": true
        },
        {
          "id": "completion-section",
          "type": "section",
          "label": "Work Completion"
        },
        {
          "id": "work-completed",
          "type": "yesNo",
          "label": "Work completed?",
          "required": false
        },
        {
          "id": "area-inspected",
          "type": "yesNo",
          "label": "Area inspected 30 min after completion?",
          "required": false
        },
        {
          "id": "completion-signature",
          "type": "signature",
          "label": "Completion Signature",
          "required": false
        }
