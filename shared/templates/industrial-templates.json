        },
        {
          "id": "fire-extinguisher",
          "type": "yesNo",
          "label": "Fire extinguisher present and charged?",
          "required": true
        },
        {
          "id": "emergency-stop",
          "type": "yesNo",
          "label": "Emergency stop functioning?",
          "required": true
        },
        {
          "id": "operational-section",
          "type": "section",
          "label": "Operational Check"
        },
        {
          "id": "brakes",
          "type": "yesNo",
          "label": "Brakes functioning properly?",
          "required": true
        },
        {
          "id": "steering",
          "type": "yesNo",
          "label": "Steering responsive?",
          "required": true
        },
        {
          "id": "controls",
          "type": "yesNo",
          "label": "All controls functioning?",
          "required": true
        },
        {
          "id": "gauges",
          "type": "yesNo",
          "label": "Gauges and indicators working?",
          "required": true
        },
        {
          "id": "defects-section",
          "type": "section",
          "label": "Defects Found"
        },
        {
          "id": "defects-found",
          "type": "yesNo",
          "label": "Any defects found?",
          "required": true
        },
        {
          "id": "defect-description",
          "type": "textarea",
          "label": "Describe defects",
          "required": false
        },
        {
          "id": "defect-photo",
          "type": "photo",
          "label": "Photo of defect",
          "required": false
        },
        {
          "id": "safe-to-operate",
          "type": "yesNo",
          "label": "Equipment safe to operate?",
          "required": true
        },
        {
          "id": "signature-section",
          "type": "section",
          "label": "Verification"
        },
        {
          "id": "operator-signature",
          "type": "signature",
          "label": "Operator Signature",
          "required": true
        }
      ]
    },
    {
      "id": "work-permit-001",
      "name": "Hot Work Permit",
      "category": "Permits",
      "description": "Authorization for welding, cutting, and other hot work",
      "estimatedTime": "10 min",
      "version": "1.0",
      "fields": [
        {
          "id": "header",
          "type": "section",
          "label": "Permit Information"
        },
        {
          "id": "permit-date",
          "type": "date",
          "label": "Permit Date",
          "required": true
        },
        {
          "id": "start-time",
          "type": "time",
