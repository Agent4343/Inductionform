# ===================
# Server Configuration
# ===================
PORT=3000
NODE_ENV=development

# ===================
# Database (PostgreSQL)
# ===================
# Railway provides DATABASE_URL automatically when you add PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/digitalforms

# ===================
# JWT Authentication
# ===================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===================
# CORS Configuration
# ===================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app-domain.com

# ===================
# File Uploads
# ===================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===================
# Email (optional, for notifications)
# ===================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@example.com

# ===================
# Security
# ===================
# Bcrypt cost factor (12 is good balance of security/speed)
BCRYPT_ROUNDS=12
